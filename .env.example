# 복사해서 .env.local 로 저장하고 값을 채운다. 실제 값은 절대 커밋하지 않는다.
# 프로젝트별(dev / prod)로 다른 값을 쓴다. Vercel 에는 환경별로 등록한다.

# --- Supabase (Project Settings → API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. RLS 를 우회한다. NEXT_PUBLIC_ 를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# --- 사이트 주소 (메일 링크, 콜백) --------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 로그인 ---------------------------------------------------------------
# 이메일 코드 자릿수. Supabase Authentication → Email OTP Length 와 같은 값 (권장 6)
NEXT_PUBLIC_OTP_LENGTH=6
# Google 로그인 버튼 표시 여부 (Supabase 에서 Google provider 를 켠 뒤 true)
NEXT_PUBLIC_GOOGLE_ENABLED=false

# --- 이메일 알림 --------------------------------------------------------
# 아래 다섯 개가 모두 있어야 알림 기능이 켜진다. 하나라도 없으면 관리자 화면에서 "이메일 서비스 설정 전"으로 표시된다.
# Resend (https://resend.com): 발송 도메인(SPF/DKIM) 인증 후 API 키 발급
RESEND_API_KEY=
# 발신자. 인증한 도메인의 주소여야 한다. 예: AI4CEO <noreply@mail.example.com>
EMAIL_FROM=
# 수신 해제 링크 서명용 임의의 긴 문자열 (16자 이상). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_HMAC_SECRET=
# /api/cron/notify 보호용 임의의 긴 문자열 (Vercel Cron 이 이 값으로 인증한다)
CRON_SECRET=
# 개발 전용: log 로 두면 메일을 보내지 않고 서버 로그에만 남긴다 (운영에서는 무시됨)
# EMAIL_PROVIDER=log

# v1 에서는 OPENAI_API_KEY / ANTHROPIC_API_KEY 를 사용하지 않는다 (AI 도우미는 v1.1).
