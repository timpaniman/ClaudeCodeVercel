# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (실제 키 포함 — 절대 커밋 금지). 문서용 .env.example만 허용
.env
.env.*
!.env.example
.env*.local

# 세션/도구 산출물
.claude/settings.local.json

# 자동 생성 (npm run db:bundle)
/supabase/bundle/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 강의 자료·개인 작업물 (이 앱의 소스가 아님, 공개 저장소에 올리지 않는다)
/*.pptx
/*.docx
/*.mp4
*.zip
/chang-book-template/

# 로컬 전용 (개인 PC 경로가 들어 있음 / bkit 진행 상태)
/start-*.bat
/.bkit-memory.json
/.bkit/
